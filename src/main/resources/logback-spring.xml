<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>
<configuration debug="false">

   <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
   <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
   <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

   <root level="INFO">
       <appender-ref ref="CONSOLE"/>
   </root>

   <springProfile name="prod">
   	   <timestamp key="timestamp" datePattern="yyyy-MM-dd"/>
   
       <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss} [%X{requestId}] %-5level - %msg %n"/>
       <property name="LOG_REGION" value="ap-northeast-2"/>
       <property name="BATCH_SIZE" value="50"/>
       <property name="FLUSH_TIME" value="30000"/>
	   <property name="BLOCK_TIME" value="5000"/>
       <property name="BUSINESS_RETENTION" value="30"/>
	   <property name="ERROR_RETENTION" value="90"/>

       <!-- business log -->
       <appender name="BUSINESS_LOG" class="ca.pjer.logback.AwsLogsAppender">
           <layout>
               <pattern>${LOG_PATTERN}</pattern>
           </layout>
           <logGroupName>/chwimong/application</logGroupName>
           <logStreamUuidPrefix>chwimong_business_${timestamp}-</logStreamUuidPrefix>
           <logRegion>${LOG_REGION}</logRegion>
           <maxBatchLogEvents>${BATCH_SIZE}</maxBatchLogEvents>
           <maxFlushTimeMillis>${FLUSH_TIME}</maxFlushTimeMillis>
		   <maxBlockTimeMillis>${BLOCK_TIME}</maxBlockTimeMillis>
		   <retentionTimeDays>${BUSINESS_RETENTION}</retentionTimeDays>
		   <filter class="ch.qos.logback.classic.filter.LevelFilter">
              <level>ERROR</level>
              <onMatch>DENY</onMatch>
              <onMismatch>ACCEPT</onMismatch>
           </filter>
       </appender>

       <!-- error log -->
       <appender name="ERROR_LOG" class="ca.pjer.logback.AwsLogsAppender">
           <layout>
               <pattern>${LOG_PATTERN}</pattern>
           </layout>
           <logGroupName>/chwimong/application</logGroupName>
           <logStreamUuidPrefix>chwimong_error_${timestamp}-</logStreamUuidPrefix>
           <logRegion>${LOG_REGION}</logRegion>
           <maxBatchLogEvents>${BATCH_SIZE}</maxBatchLogEvents>
           <maxFlushTimeMillis>${FLUSH_TIME}</maxFlushTimeMillis>
		   <maxBlockTimeMillis>${BLOCK_TIME}</maxBlockTimeMillis>
		   <retentionTimeDays>${ERROR_RETENTION}</retentionTimeDays>
		   <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
              <level>ERROR</level>
           </filter>
       </appender>

       <logger name="com.chwimong.project" level="INFO" additivity="false">
          <appender-ref ref="BUSINESS_LOG"/>
          <appender-ref ref="ERROR_LOG"/>
          <appender-ref ref="CONSOLE"/>
       </logger>
   </springProfile>
</configuration>